generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  name     String
  phone    String?  @unique
  password String
  role     UserRole @default(CUSTOMER)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isActive        Boolean @default(true)
  isDeleted       Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders    Order[]
  cart      Cart?
  addresses Address[]
  reviews   Review[]
  otps      OTP[]
  auditLogs AuditLog[]

  createdGiftCards     GiftCardProduct[] @relation("GiftCardCreatedBy")
  updatedGiftCards     GiftCardProduct[] @relation("GiftCardUpdatedBy")
  createdGiftCardCodes GiftCardCode[]    @relation("GiftCardCodeCreatedBy")
  updatedGiftCardCodes GiftCardCode[]    @relation("GiftCardCodeUpdatedBy")

  createdGameTopUps GameTopUpProduct[] @relation("GameTopUpCreatedBy")
  updatedGameTopUps GameTopUpProduct[] @relation("GameTopUpUpdatedBy")

  createdSubscriptions SubscriptionProduct[] @relation("SubscriptionCreatedBy")
  updatedSubscriptions SubscriptionProduct[] @relation("SubscriptionUpdatedBy")

  @@index([role])
  @@index([isActive])
  @@index([isDeleted])
  @@map("users")
}

model OTP {
  id        String   @id @default(uuid())
  code      String
  type      OtpType
  expiresAt DateTime
  used      Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
  @@map("otps")
}

//////////////////////////////////////////////////
// ADDRESS
//////////////////////////////////////////////////

model Address {
  id          String  @id @default(uuid())
  addressLine String
  city        String
  country     String
  postalCode  String?
  isDefault   Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

//////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////

model Category {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  description String?
  image       String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  giftCards     GiftCardProduct[]
  gameTopUps    GameTopUpProduct[]
  subscriptions SubscriptionProduct[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

//////////////////////////////////////////////////
// GIFT CARD PRODUCT
//////////////////////////////////////////////////

model GiftCardProduct {
  id String @id @default(uuid())

  brand            String
  title            String
  slug             String  @unique
  description      String?
  shortDescription String?
  image            String
  logoUrl          String?
  bannerImage      String?

  cardCurrency String               @default("USD")
  region       GiftCardRegion       @default(GLOBAL)
  deliveryType GiftCardDeliveryType @default(CODE)

  instructions       String?
  termsAndConditions String?

  status     ProductStatus @default(ACTIVE)
  isFeatured Boolean       @default(false)
  sortOrder  Int           @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdById String?
  createdBy   User?   @relation("GiftCardCreatedBy", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("GiftCardUpdatedBy", fields: [updatedById], references: [id])

  denominations GiftCardDenomination[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([brand])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([sortOrder])
  @@map("gift_card_products")
}

model GiftCardDenomination {
  id String @id @default(uuid())

  giftCardProductId String
  giftCardProduct   GiftCardProduct @relation(fields: [giftCardProductId], references: [id], onDelete: Restrict)

  title String?

  // Customer যে amount pay করবে
  sellingPriceBDT Decimal @db.Decimal(12, 2)

  // Gift card-এর আসল value
  cardValue Decimal @db.Decimal(12, 2)

  cardCurrency String @default("USD")

  costPriceBDT Decimal? @db.Decimal(12, 2)

  discountAmountBDT Decimal? @db.Decimal(12, 2)
  discountPercent   Decimal? @db.Decimal(5, 2)
  discountLabel     String?

  isPopular Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // null মানে unlimited বা external supplier inventory
  stockQuantity Int?

  cartItems  CartItem[]
  orderItems OrderItem[]
  codes      GiftCardCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([giftCardProductId, cardValue, cardCurrency])
  @@index([giftCardProductId])
  @@index([sellingPriceBDT])
  @@index([isPopular])
  @@index([isActive])
  @@index([sortOrder])
  @@map("gift_card_denominations")
}

//////////////////////////////////////////////////
// GIFT CARD INVENTORY
//////////////////////////////////////////////////

model GiftCardCode {
  id String @id @default(uuid())

  denominationId String
  denomination   GiftCardDenomination @relation(fields: [denominationId], references: [id], onDelete: Restrict)

  // Production-এ encrypted value রাখা ভালো
  code       String    @unique
  pin        String?
  serialNo   String?
  expiryDate DateTime?

  status     GiftCardCodeStatus @default(AVAILABLE)
  reservedAt DateTime?
  soldAt     DateTime?

  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  delivery GiftCardDelivery?

  createdById String?
  createdBy   User?   @relation("GiftCardCodeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("GiftCardCodeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([denominationId, status])
  @@index([status])
  @@index([expiryDate])
  @@index([orderItemId])
  @@map("gift_card_codes")
}

model GiftCardDelivery {
  id String @id @default(uuid())

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  inventoryCodeId String       @unique
  inventoryCode   GiftCardCode @relation(fields: [inventoryCodeId], references: [id], onDelete: Restrict)

  cardNameSnapshot   String
  brandSnapshot      String
  faceValueSnapshot  Decimal        @db.Decimal(12, 2)
  currencySnapshot   String
  expiryDateSnapshot DateTime?
  deliveryEmail      String
  deliveryStatus     DeliveryStatus @default(PENDING)
  deliveredAt        DateTime?
  failureReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderItemId])
  @@index([deliveryEmail])
  @@index([deliveryStatus])
  @@map("gift_card_deliveries")
}

//////////////////////////////////////////////////
// GAME TOP-UP PRODUCT
//////////////////////////////////////////////////

model GameTopUpProduct {
  id String @id @default(uuid())

  name        String
  slug        String  @unique
  subHeading  String?
  title       String
  description String?

  logo        String
  bannerImage String?

  gameCurrencyName   String
  fulfillmentType    GameTopUpFulfillmentType
  instructions       String?
  estimatedDelivery  String?
  termsAndConditions String?

  status     ProductStatus @default(ACTIVE)
  isFeatured Boolean       @default(false)
  sortOrder  Int           @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdById String?
  createdBy   User?   @relation("GameTopUpCreatedBy", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("GameTopUpUpdatedBy", fields: [updatedById], references: [id])

  packages    GameTopUpPackage[]
  inputFields GameTopUpInputField[]

  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([sortOrder])
  @@map("game_top_up_products")
}

model GameTopUpPackage {
  id String @id @default(uuid())

  gameTopUpProductId String
  gameTopUpProduct   GameTopUpProduct @relation(fields: [gameTopUpProductId], references: [id], onDelete: Cascade)

  title String?

  sellingPriceBDT Decimal @db.Decimal(12, 2)

  gameCurrencyAmount Int

  bonusCurrencyAmount Int @default(0)

  costPriceBDT Decimal? @db.Decimal(12, 2)

  discountAmountBDT Decimal? @db.Decimal(12, 2)
  discountPercent   Decimal? @db.Decimal(5, 2)
  discountLabel     String?

  isPopular Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // External supplier হলে null হতে পারে
  stockQuantity Int?

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameTopUpProductId, gameCurrencyAmount, bonusCurrencyAmount])
  @@index([gameTopUpProductId])
  @@index([sellingPriceBDT])
  @@index([isPopular])
  @@index([isActive])
  @@index([sortOrder])
  @@map("game_top_up_packages")
}

model GameTopUpInputField {
  id String @id @default(uuid())

  gameTopUpProductId String
  gameTopUpProduct   GameTopUpProduct @relation(fields: [gameTopUpProductId], references: [id], onDelete: Cascade)

  name        String
  label       String
  type        ProductInputType @default(TEXT)
  placeholder String?
  helpText    String?

  isRequired Boolean @default(true)

  // SELECT/RADIO-এর options:
  // [{"label":"Asia","value":"asia"}]
  options Json?

  validationRules Json?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameTopUpProductId, name])
  @@index([gameTopUpProductId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("game_top_up_input_fields")
}

//////////////////////////////////////////////////
// SUBSCRIPTION PRODUCT
//////////////////////////////////////////////////

model SubscriptionProduct {
  id String @id @default(uuid())

  platformName String
  slug         String  @unique
  title        String
  subHeading   String?
  description  String?

  logo        String
  bannerImage String?

  deliveryType       SubscriptionDeliveryType
  instructions       String?
  estimatedDelivery  String?
  termsAndConditions String?

  isRenewable Boolean @default(true)

  status     ProductStatus @default(ACTIVE)
  isFeatured Boolean       @default(false)
  sortOrder  Int           @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdById String?
  createdBy   User?   @relation("SubscriptionCreatedBy", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("SubscriptionUpdatedBy", fields: [updatedById], references: [id])

  plans       SubscriptionPlan[]
  inputFields SubscriptionInputField[]

  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([platformName])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([sortOrder])
  @@map("subscription_products")
}

model SubscriptionPlan {
  id String @id @default(uuid())

  subscriptionProductId String
  subscriptionProduct   SubscriptionProduct @relation(fields: [subscriptionProductId], references: [id], onDelete: Cascade)

  title       String
  description String?

  sellingPriceBDT Decimal  @db.Decimal(12, 2)
  costPriceBDT    Decimal? @db.Decimal(12, 2)

  billingCycle SubscriptionBillingCycle

  // CUSTOM duration-এর জন্য
  durationDays  Int?
  durationLabel String?

  maxDevices       Int?
  maxUsers         Int?
  screenCount      Int?
  profileCount     Int?
  accountType      String?
  subscriptionTier String?

  features String[] @default([])

  discountAmountBDT Decimal? @db.Decimal(12, 2)
  discountPercent   Decimal? @db.Decimal(5, 2)
  discountLabel     String?

  isPopular Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  stockQuantity Int?

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionProductId])
  @@index([sellingPriceBDT])
  @@index([billingCycle])
  @@index([isPopular])
  @@index([isActive])
  @@index([sortOrder])
  @@map("subscription_plans")
}

model SubscriptionInputField {
  id String @id @default(uuid())

  subscriptionProductId String
  subscriptionProduct   SubscriptionProduct @relation(fields: [subscriptionProductId], references: [id], onDelete: Cascade)

  name        String
  label       String
  type        ProductInputType @default(TEXT)
  placeholder String?
  helpText    String?

  isRequired Boolean @default(true)

  options         Json?
  validationRules Json?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionProductId, name])
  @@index([subscriptionProductId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("subscription_input_fields")
}

//////////////////////////////////////////////////
// REVIEW
//////////////////////////////////////////////////

model Review {
  id      String  @id @default(uuid())
  rating  Int
  comment String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productType DigitalProductType

  giftCardProductId String?
  giftCardProduct   GiftCardProduct? @relation(fields: [giftCardProductId], references: [id], onDelete: Cascade)

  gameTopUpProductId String?
  gameTopUpProduct   GameTopUpProduct? @relation(fields: [gameTopUpProductId], references: [id], onDelete: Cascade)

  subscriptionProductId String?
  subscriptionProduct   SubscriptionProduct? @relation(fields: [subscriptionProductId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, giftCardProductId])
  @@unique([userId, gameTopUpProductId])
  @@unique([userId, subscriptionProductId])
  @@index([productType])
  @@index([giftCardProductId])
  @@index([gameTopUpProductId])
  @@index([subscriptionProductId])
  @@map("reviews")
}

//////////////////////////////////////////////////
// CART
//////////////////////////////////////////////////

model Cart {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id String @id @default(uuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productType DigitalProductType

  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)

  // playerId, serverId, email ইত্যাদি
  customerInputs Json?

  //////////////////////////////////////////////////
  // GIFT CARD
  //////////////////////////////////////////////////

  giftCardProductId String?
  giftCardProduct   GiftCardProduct? @relation(fields: [giftCardProductId], references: [id])

  giftCardDenominationId String?
  giftCardDenomination   GiftCardDenomination? @relation(fields: [giftCardDenominationId], references: [id])

  //////////////////////////////////////////////////
  // GAME TOP-UP
  //////////////////////////////////////////////////

  gameTopUpProductId String?
  gameTopUpProduct   GameTopUpProduct? @relation(fields: [gameTopUpProductId], references: [id])

  gameTopUpPackageId String?
  gameTopUpPackage   GameTopUpPackage? @relation(fields: [gameTopUpPackageId], references: [id])

  //////////////////////////////////////////////////
  // SUBSCRIPTION
  //////////////////////////////////////////////////

  subscriptionProductId String?
  subscriptionProduct   SubscriptionProduct? @relation(fields: [subscriptionProductId], references: [id])

  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  // Same option যেন cart-এ duplicate না হয়
  optionKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productType, optionKey])
  @@index([giftCardProductId])
  @@index([giftCardDenominationId])
  @@index([gameTopUpProductId])
  @@index([gameTopUpPackageId])
  @@index([subscriptionProductId])
  @@index([subscriptionPlanId])
  @@map("cart_items")
}

//////////////////////////////////////////////////
// ORDER
//////////////////////////////////////////////////

model Order {
  id            String  @id @default(uuid())
  orderNumber   String  @unique
  notes         String?
  deliveryEmail String?

  subtotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  totalCost     Decimal @db.Decimal(12, 2)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  items   OrderItem[]
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([deliveryEmail])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productType DigitalProductType

  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  // Snapshot data, product update হলেও পুরোনো order ঠিক থাকবে
  productTitle String
  optionTitle  String?
  productImage String?

  customerInputs Json?

  deliveryStatus       DeliveryStatus @default(PENDING)
  fulfillmentReference String?
  fulfillmentData      Json?
  failureReason        String?
  fulfilledAt          DateTime?

  //////////////////////////////////////////////////
  // GIFT CARD
  //////////////////////////////////////////////////

  giftCardProductId String?
  giftCardProduct   GiftCardProduct? @relation(fields: [giftCardProductId], references: [id])

  giftCardDenominationId String?
  giftCardDenomination   GiftCardDenomination? @relation(fields: [giftCardDenominationId], references: [id])

  assignedGiftCardCodes GiftCardCode[]
  giftCardDeliveries    GiftCardDelivery[]

  brandSnapshot        String?
  faceValueSnapshot    Decimal? @db.Decimal(12, 2)
  faceCurrencySnapshot String?

  //////////////////////////////////////////////////
  // GAME TOP-UP
  //////////////////////////////////////////////////

  gameTopUpProductId String?
  gameTopUpProduct   GameTopUpProduct? @relation(fields: [gameTopUpProductId], references: [id])

  gameTopUpPackageId String?
  gameTopUpPackage   GameTopUpPackage? @relation(fields: [gameTopUpPackageId], references: [id])

  //////////////////////////////////////////////////
  // SUBSCRIPTION
  //////////////////////////////////////////////////

  subscriptionProductId String?
  subscriptionProduct   SubscriptionProduct? @relation(fields: [subscriptionProductId], references: [id])

  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productType])
  @@index([deliveryStatus])
  @@index([giftCardProductId])
  @@index([giftCardDenominationId])
  @@index([gameTopUpProductId])
  @@index([gameTopUpPackageId])
  @@index([subscriptionProductId])
  @@index([subscriptionPlanId])
  @@map("order_items")
}

//////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////

model Payment {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  paymentMethod   PaymentMethod
  paymentProvider String        @default("mock")
  paymentStatus   PaymentStatus @default(PENDING)

  paymentId         String? @unique
  transactionId     String?
  providerPaymentId String?

  merchantInvoiceNumber String?
  payerAccount          String?

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("BDT")

  providerResponse Json?
  rawResponse      Json?
  failureReason    String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([paymentMethod])
  @@index([paymentProvider])
  @@index([paymentStatus])
  @@index([transactionId])
  @@index([createdAt])
  @@map("payments")
}

//////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////

model AuditLog {
  id String @id @default(uuid())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  action     String
  entityType String
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
