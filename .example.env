NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:password@localhost:5432/ontor?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="ontor"

JWT_ACCESS_SECRET="replace-with-a-long-random-app-secret"
JWT_EXPIRES_IN=24h
SALT_ROUNDS=12

REDIS_URL="redis://localhost:6379"
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=100kb
URL_ENCODED_BODY_LIMIT=100kb
MAX_URL_LENGTH=2048
REQUEST_TIMEOUT_MS=30000
MAX_UPLOAD_SIZE_BYTES=5242880

LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=14

PAYMENT_PROVIDER=mock
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=ontor/products

SMTP_HOST=smtp.example.com
SMTP_SERVICE=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PHONE=
