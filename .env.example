# ==================================================
# Application
# ==================================================
NODE_ENV=development
PORT=5000
API_DOCS_ENABLED=true
CLIENT_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Request limits. Time values are milliseconds unless stated otherwise.
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=100kb
URL_ENCODED_BODY_LIMIT=100kb
MAX_URL_LENGTH=2048
REQUEST_TIMEOUT_MS=30000
MAX_UPLOAD_SIZE_BYTES=5242880

# ==================================================
# Database and Redis
# ==================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/ontor?schema=public

# Used by docker-compose.yml, not read directly by the application.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ontor

# Optional. If omitted, rate limiting uses the in-memory store.
REDIS_URL=redis://localhost:6379

# ==================================================
# Authentication
# ==================================================
# Required in production. Use a unique random secret of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-application-secret
JWT_EXPIRES_IN=24h
SALT_ROUNDS=12

# ==================================================
# Logging
# ==================================================
LOG_LEVEL=info
# Keep false on Render so structured logs are captured from stdout.
LOG_TO_FILE=false
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# ==================================================
# Cloudinary (required for product image uploads)
# ==================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=ontor/products

# ==================================================
# Email (optional in local development)
# ==================================================
SMTP_HOST=smtp.example.com
SMTP_SERVICE=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ==================================================
# Payment / aamarPay
# ==================================================
# PAYMENT_PROVIDER=mock is accepted only while NODE_ENV=test.
PAYMENT_PROVIDER=aamarpay
AAMARPAY_MODE=sandbox
AAMARPAY_STORE_ID=aamarpaytest
# Required for aamarPay. Obtain a sandbox or production key from the provider.
AAMARPAY_SIGNATURE_KEY=
AAMARPAY_BASE_URL=https://sandbox.aamarpay.com
AAMARPAY_PAYMENT_URL=https://sandbox.aamarpay.com/jsonpost.php
AAMARPAY_TRANSACTION_URL=https://sandbox.aamarpay.com/api/v1/trxcheck/request.php
AAMARPAY_REQUEST_TIMEOUT_MS=30000

# ==================================================
# Gift cards
# ==================================================
GIFT_CARD_RESERVATION_MINUTES=5
GIFT_CARD_RESERVATION_SWEEP_MS=10000
GIFT_CARD_EMAIL_RETRY_MINUTES=5
GIFT_CARD_EMAIL_MAX_ATTEMPTS=5
# Required for real gift-card inventory: 32 random bytes encoded as base64.
# Generate once with `openssl rand -base64 32`; never rotate it casually.
GIFT_CARD_ENCRYPTION_KEY=

# ==================================================
# Game top-up provider and worker
# ==================================================
GAME_TOPUP_PROVIDER=mock
MOCK_GAME_API_RESULT=success
MOCK_GAME_API_DELAY_MS=3000
MOCK_GAME_PROVIDER_BALANCE=1000000
TOP_UP_RETRY_BACKOFF_SECONDS=30,120,600,1800
TOP_UP_PROCESSING_STALE_SECONDS=300
TOP_UP_WORKER_INTERVAL_MS=30000
TOP_UP_MAX_PROVIDER_ATTEMPTS=5
TOP_UP_CANCELLATION_WINDOW_SECONDS=120
TOP_UP_QUEUE_TIME_ZONE=Asia/Dhaka
TOP_UP_EMAIL_RETRY_MINUTES=5
TOP_UP_EMAIL_MAX_ATTEMPTS=5

# ==================================================
# Seed administrator (used by prisma/seed.js)
# ==================================================
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PHONE=

# ==================================================
# Test switches (optional; normally set by npm scripts)
# ==================================================
RUN_USER_INTEGRATION_TESTS=false
RUN_GIFT_CARD_INTEGRATION_TESTS=false
RUN_GAME_TOPUP_INTEGRATION_TESTS=false
TEST_SCHEMA_MODE=push
